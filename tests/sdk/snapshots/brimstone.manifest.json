    "qaqc_samples": {
      "aliases": [],
      "automations": [
        "qaqc_samples.onchange.0"
      ],
      "deps": [],
      "doc": "One changed workbook of this site: its samples. Solera runs it for every\nfile_id whose version changed, eight at a time, writes all of them in one\nstore write, and removes the samples of deleted workbooks; the store\nstamps `file_id` and `site`. A workbook that raises is recorded as a\nfailing key, and the others still commit.",
      "inputs": {
        "workbook": {
          "batch_size": 100,
          "each": {
            "concurrency": 8
          },
          "kind": "incremental",
          "meta": null,
          "output": "qaqc_files"
        }
      },
      "on_version_change": "fail",
      "outputs": [
        {
          "config": {
            "partition_column": "site",
            "primary_key": [
              "file_id",
              "sample_id"
            ],
            "schema": "qaqc"
          },
          "incremental": true,
          "key": "file_id",
          "migrations": [
            "0001_analyst",
            "0002_measured_tz"
          ],
          "name": "qaqc_samples",
          "partition_set": false,
          "revision": null,
          "store": "postgres"
        }
      ],
      "partitions": {
        "dims": {
          "sites": {
            "kind": "set",
            "output": "sites"
          }
        }
      },
      "placement": {
        "environment": {},
        "executor": "local",
        "kind": "Local",
        "placement": {}
      },
      "retention": null,
      "retries": {
        "backoff": "exponential",
        "delay": 1.0,
        "n": 3
      },
      "tags": {},
      "timeout": 3600,
      "types": {
        "params": {
          "sharepoint": {
            "class": "brimstone.SharePointClient"
          },
          "workbook": {
            "args": [
              {
                "class": "builtins.dict"
              }
            ],
            "generic": "list"
          }
        },
        "return": {
          "class": "pandas.core.frame.DataFrame"
        }
      },
      "version": "2"
    },
